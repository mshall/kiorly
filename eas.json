{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote", "requireCommit": false },
  "build": {
    "base": { "node": "24.11.0", "environment": "development" },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "channel": "development",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleDebug" },
      "env": { "APP_ENV": "development", "EXPO_PUBLIC_ENV": "development" }
    },
    "development-simulator": { "extends": "development", "ios": { "simulator": true } },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "channel": "preview",
      "android": { "buildType": "apk", "gradleCommand": ":app:assembleRelease" },
      "ios": { "buildConfiguration": "Release" },
      "env": { "APP_ENV": "preview", "EXPO_PUBLIC_ENV": "staging" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production",
      "channel": "production",
      "android": { "buildType": "app-bundle", "gradleCommand": ":app:bundleRelease" },
      "ios": { "buildConfiguration": "Release" },
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_ENV": "production" }
    }
  },
  "submit": { "production": { "android": { "track": "internal", "releaseStatus": "draft" }, "ios": {} } }
}
